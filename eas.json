{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_BACKEND": "mock" }
    },
    "production": {
      "autoIncrement": true,
      "env": { "EXPO_PUBLIC_BACKEND": "firebase" }
    }
  },
  "submit": {
    "production": {}
  }
}
