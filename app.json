{
  "expo": {
    "name": "Meridian",
    "slug": "meridian",
    "scheme": "meridian",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#6B3BEA",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ishaishai.meridian"
    },
    "android": {
      "package": "com.ishaishai.meridian",
      "adaptiveIcon": {
        "backgroundColor": "#6B3BEA",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "bundler": "metro",
      "favicon": "./assets/favicon.png",
      "name": "Meridian — quick trivia for everyone",
      "shortName": "Meridian",
      "description": "A new trivia game every day. Sixty seconds, three seconds a question, one crown.",
      "themeColor": "#6B3BEA",
      "backgroundColor": "#6B3BEA"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#6B3BEA"
        }
      ],
      "expo-audio"
    ]
  }
}
