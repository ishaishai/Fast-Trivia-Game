{
  "name": "meridian",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/atkinson-hyperlegible-next": "^0.4.1",
    "@expo-google-fonts/fredoka": "^0.4.1",
    "@expo/metro-runtime": "~58.0.15",
    "@react-native-async-storage/async-storage": "2.2.0",
    "eslint-config-expo": "~58.0.4",
    "expo": "~58.0.21",
    "expo-audio": "~58.0.10",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.14",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-linking": "~58.0.15",
    "expo-router": "~58.0.28",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "firebase": "^13.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "start": "expo start",
    "web": "expo start --web --port 8091",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web:firebase": "EXPO_PUBLIC_BACKEND=firebase expo start --web --port 8091 --clear",
    "web:emulators": "EXPO_PUBLIC_BACKEND=firebase EXPO_PUBLIC_USE_EMULATORS=1 expo start --web --port 8091 --clear",
    "emulators": "npm --prefix functions run build && firebase emulators:start --project demo-meridian --only auth,firestore,functions",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "vitest run",
    "assets": "node scripts/generate-assets.mjs",
    "build:web": "expo export --platform web && node scripts/postexport-web.mjs",
    "build:web:firebase": "EXPO_PUBLIC_BACKEND=firebase expo export --platform web --clear && node scripts/postexport-web.mjs",
    "smoke:firebase": "npm --prefix functions run build && firebase emulators:exec --project demo-meridian --only auth,firestore,functions \"node scripts/smoke-firebase.mjs\"",
    "deploy": "npm run build:web:firebase && firebase deploy --only hosting,firestore,functions"
  },
  "private": true
}
