# Which server the app talks to: "mock" (default, offline, nothing to set up) or "firebase".
EXPO_PUBLIC_BACKEND=mock

# Firebase web app config — Firebase Console › Project settings › Your apps › Web app.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Region the `api` function is deployed to (functions/src/index.ts).
EXPO_PUBLIC_FUNCTIONS_REGION=europe-west1

# Local emulators (npm run emulators): set to 1. The project id becomes demo-meridian.
EXPO_PUBLIC_USE_EMULATORS=
# Use 10.0.2.2 for the Android emulator; your machine's LAN IP for a physical phone.
EXPO_PUBLIC_EMULATOR_HOST=127.0.0.1

# Optional: added to shared results ("meridian.example").
EXPO_PUBLIC_SITE_URL=
